@article{huber2022bavart,
  author = {Huber, Florian and Rossini, Luca},
  title = {Inference in Bayesian Additive Vector Autoregressive Tree Models},
  journal = {The Annals of Applied Statistics},
  year = {2022},
  volume = {16},
  number = {1},
  pages = {104--123},
  url = {https://arxiv.org/html/2006.16333v2},
  note = {Primary preprint sections 3 and 4.1 checked on 2026-10-23. The yield application fixes the Nelson--Siegel parameter at 0.0609, extracts three factors by period-specific OLS, models their dynamics with BAVART and maps forecasts back to yields; direct yield modelling is also compared. Stochastic volatility is included. Final journal volume and pages were previously checked against public implementation references; that bibliographic source is secondary.}
}


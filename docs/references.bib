  year = {2024},
  eprint = {2408.12863},
  archivePrefix = {arXiv},
  url = {https://arxiv.org/abs/2408.12863},
  note = {Primary arXiv:2408.12863v2 HTML sections 2 and 3.1 and Appendix A checked on 2026-10-23 after initial access denial was resolved. Confirmed the six-dimensional yields--macro model, regime-dependent transition/covariance/means, sequential marginal-likelihood tree selection, and posterior state/parameter sampling conditional on the selected tree. The article uses Liu--Wu zero-coupon yields and manufacturing capacity utilization, not the full data specification of this repository's pilot.}
}

